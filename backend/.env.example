PORT=5000
NODE_ENV=development
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_encryption_secret_here
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ADOS <onboarding@resend.dev>
APP_URL=http://localhost:5173
EMAIL_VERIFICATION_EXPIRES_MINUTES=60
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_ADS_REDIRECT_URI=http://localhost:5000/api/v1/google-ads/callback
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token_here
ENCRYPTION_KEY=your_optional_32_byte_hex_encryption_key_here
